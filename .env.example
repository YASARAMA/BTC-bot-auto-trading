# Copy to .env and fill in. Never commit .env.
#
# Exchange API credentials. Create the key with TRADE + READ permissions only.
# Do NOT enable withdrawals. Restrict it to your server's IP if the exchange allows it.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (OKX, KuCoin, Coinbase Advanced) also need a passphrase:
EXCHANGE_API_PASSWORD=

# Live trading switch. Real orders are placed ONLY when this is "true" AND config.yaml has
# exchange.live: true. Leave empty for paper trading.
LIVE_TRADING=

# Optional: path to the config file (default ./config.yaml)
BOT_CONFIG=

# Optional: GitHub token for self-updates from a PRIVATE repository (read-only "Contents" is enough).
# Not needed while the repository is public.
GITHUB_TOKEN=

# Optional notifications. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
